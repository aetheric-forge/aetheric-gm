@page "/"
@inject ICampaignRepository Repository
@inject IRulesCatalog RulesCatalog
@inject IRulesPackageInstaller PackageInstaller
@inject ISshCredentialService CredentialService
@inject AuthenticationStateProvider AuthenticationStateProvider
<PageTitle>Campaigns · Aetheric GM</PageTitle>
<header class="page-header"><div><p class="eyebrow">Campaign workspace</p><h1>Your campaigns</h1><p>Keep every table's material in its own workspace.</p></div><button class="primary" @onclick="BeginCreate">New campaign</button></header>
<div class="toolbar"><label><input type="checkbox" @bind="showArchived" @bind:after="LoadAsync" /> Show archived</label></div>
@if (editing)
{
 <section class="editor panel"><h2>@(selected is null ? "Create campaign" : "Campaign details")</h2>
  @if (!string.IsNullOrEmpty(error)) { <p class="error">@error</p> }
  <label>Name <input @bind="draft.Name" autofocus /></label><div class="field-row"><label>Ruleset <select @bind="draft.Ruleset"><option value="">No ruleset</option>@foreach (var ruleset in rulesets) { <option value="@ruleset.Reference.ToString()">@ruleset.Name · @ruleset.Reference.Version</option> }</select></label><label>Setting <input @bind="draft.Setting" /></label></div><label>Summary <textarea @bind="draft.Summary" rows="4"></textarea></label>
  <section class="package-loader"><div><p class="eyebrow">Rules packages</p><h3>Load from Git</h3><p>Install a declarative rules package from a public or private SSH repository. It will be pinned to the exact commit loaded.</p></div>
   @if (!string.IsNullOrEmpty(packageMessage)) { <p class="success">@packageMessage</p> }
   @if (!string.IsNullOrEmpty(packageError)) { <p class="error">@packageError</p> }
   <label>SSH repository <input @bind="packageDraft.RepositoryUrl" placeholder="git@example.com:owner/rules.git" /></label>
   <div class="field-row"><label>Branch, tag, or commit <input @bind="packageDraft.Revision" /></label><label>SSH credential <select @bind="packageDraft.Credential"><option value="">No credential (public)</option>@foreach (var credential in sshCredentials) { <option value="@credential.Id">@credential.Name · @credential.Algorithm</option> }</select></label></div>
   @if (SelectedCredential?.RequiresPassphrase == true) { <label>Passphrase <input type="password" autocomplete="off" @bind="packageDraft.Passphrase" /></label> }
   @if (hostKey is not null)
   {
    <div class="host-key-review"><h4>@(hostKeyChanged ? "SSH host identity changed" : "Review SSH host")</h4><p>Confirm this identity through a trusted source before continuing. A changed identity may indicate an attack.</p><dl><dt>Host</dt><dd>@hostKey.Host:@hostKey.Port</dd><dt>Algorithm</dt><dd>@hostKey.Algorithm</dd><dt>Fingerprint</dt><dd><code>@hostKey.Fingerprint</code></dd></dl><div class="actions"><button class="danger" disabled="@installing" @onclick="AcceptHostAndInstallAsync">Trust this identity and install</button><button class="quiet" @onclick="ClearHostReview">Cancel</button></div></div>
   }
   else { <button class="quiet" disabled="@installing" @onclick="InstallAsync">@(installing ? "Loading…" : "Review host and load package")</button> }
   @if (installedPackages.Count > 0) { <div class="installed-packages"><h4>Available packages</h4>@foreach (var package in installedPackages) { <p><strong>@package.Name</strong> · @package.Ruleset.Version <span class="commit">@package.ResolvedCommit[..Math.Min(10, package.ResolvedCommit.Length)]</span></p> }</div> }
  </section>
  <div class="actions"><button class="primary" @onclick="SaveAsync">Save campaign</button><button class="quiet" @onclick="Cancel">Cancel</button></div>
 </section>
}
<section class="campaign-grid">@if (campaigns.Count == 0) { <div class="empty panel"><h2>No campaigns here yet</h2><p>Create a campaign to establish your first workspace.</p></div> } @foreach (var campaign in campaigns) { <article class="campaign-card panel @(campaign.Id == selected?.Id ? "selected" : "")"><div class="card-heading"><div><h2>@campaign.Name</h2><p>@RulesetName(campaign) · @(campaign.Setting ?? "Setting not set")</p></div>@if (campaign.Id == selected?.Id) { <span class="badge">Open</span> }</div><p class="summary">@(campaign.Summary ?? "No summary yet.")</p><p class="timestamp">Updated @campaign.UpdatedAt.LocalDateTime.ToString("MMM d, yyyy")</p><div class="actions">@if (campaign.ArchivedAt is null) { <button class="primary" @onclick="() => OpenAsync(campaign)">Open</button><button class="quiet" @onclick="() => Edit(campaign)">Edit</button><button class="danger" @onclick="() => ArchiveAsync(campaign)">Archive</button> } else { <button class="quiet" @onclick="() => RestoreAsync(campaign)">Restore</button> }</div></article> }</section>
@code {
 private List<Campaign> campaigns = []; private IReadOnlyList<RulesetDescriptor> rulesets = []; private IReadOnlyList<SshCredential> sshCredentials = []; private IReadOnlyList<InstalledRulesPackage> installedPackages = [];
 private Campaign? selected; private bool showArchived, editing, installing, hostKeyChanged; private string? error, packageError, packageMessage, ownerSubjectId; private SshHostKey? hostKey; private Draft draft = new(); private PackageDraft packageDraft = new();
 private SshCredential? SelectedCredential => Guid.TryParse(packageDraft.Credential, out var id) ? sshCredentials.FirstOrDefault(value => value.Id == id) : null;
 protected override async Task OnInitializedAsync() { var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User; ownerSubjectId = user.FindFirstValue("sub") ?? user.FindFirstValue(ClaimTypes.NameIdentifier); rulesets = RulesCatalog.List(); await LoadAsync(); if (ownerSubjectId is not null) { sshCredentials = await CredentialService.ListAsync(ownerSubjectId); installedPackages = await PackageInstaller.ListAsync(ownerSubjectId); rulesets = RulesCatalog.List().Concat(await PackageInstaller.ListRulesetsAsync(ownerSubjectId)).GroupBy(value => value.Reference).Select(group => group.First()).ToArray(); } var id = await Repository.GetSelectedIdAsync(); selected = id is null ? null : await Repository.GetAsync(id.Value); }
 private async Task LoadAsync() => campaigns = (await Repository.ListAsync(showArchived)).ToList();
 private void BeginCreate() { selected = null; draft = new(); ResetPackageForm(); error = null; editing = true; }
 private void Edit(Campaign campaign) { selected = campaign; draft = new() { Name = campaign.Name, Ruleset = campaign.Ruleset?.ToString() ?? "", Setting = campaign.Setting, Summary = campaign.Summary }; ResetPackageForm(); error = null; editing = true; }
 private void Cancel() { editing = false; error = null; }
 private async Task SaveAsync() { try { var now = DateTimeOffset.UtcNow; var campaign = selected ?? Campaign.Create(draft.Name, now); campaign.Update(draft.Name, null, draft.Setting, draft.Summary, now); campaign.SelectRuleset(rulesets.FirstOrDefault(item => item.Reference.ToString() == draft.Ruleset)?.Reference, now); await Repository.SaveAsync(campaign); await OpenAsync(campaign); editing = false; await LoadAsync(); } catch (ArgumentException ex) { error = ex.Message; } }
 private async Task InstallAsync() => await InstallAsync(null); private async Task AcceptHostAndInstallAsync() => await InstallAsync(hostKey?.Fingerprint);
 private async Task InstallAsync(string? acceptedFingerprint) { if (ownerSubjectId is null) { packageError = "Your signed-in profile could not be identified."; return; } installing = true; packageError = packageMessage = null; try { var credentialId = Guid.TryParse(packageDraft.Credential, out var id) ? id : (Guid?)null; var result = await PackageInstaller.InstallFromGitAsync(ownerSubjectId, new(packageDraft.RepositoryUrl, packageDraft.Revision, credentialId, packageDraft.Passphrase, acceptedFingerprint)); if (result is GitPackageInstallResult.HostKeyApprovalRequired approval) { hostKey = approval.HostKey; hostKeyChanged = approval.Changed; return; } var installed = ((GitPackageInstallResult.Installed)result).Package; packageMessage = $"{installed.Name} {installed.Ruleset.Version} installed at commit {installed.ResolvedCommit[..Math.Min(10, installed.ResolvedCommit.Length)]}."; hostKey = null; packageDraft.Passphrase = null; installedPackages = await PackageInstaller.ListAsync(ownerSubjectId); rulesets = RulesCatalog.List().Concat(await PackageInstaller.ListRulesetsAsync(ownerSubjectId)).GroupBy(value => value.Reference).Select(group => group.First()).ToArray(); } catch (RulesPackageInstallException exception) { packageError = exception.Message; hostKey = null; } catch (KeyNotFoundException) { packageError = "The selected SSH credential is no longer available."; hostKey = null; } finally { installing = false; } }
 private void ClearHostReview() { hostKey = null; hostKeyChanged = false; } private void ResetPackageForm() { packageDraft = new(); hostKey = null; hostKeyChanged = false; packageError = packageMessage = null; }
 private async Task OpenAsync(Campaign campaign) { selected = campaign; await Repository.SetSelectedIdAsync(campaign.Id); } private async Task ArchiveAsync(Campaign campaign) { campaign.Archive(DateTimeOffset.UtcNow); await Repository.SaveAsync(campaign); if (selected?.Id == campaign.Id) { selected = null; await Repository.SetSelectedIdAsync(null); } await LoadAsync(); } private async Task RestoreAsync(Campaign campaign) { campaign.Restore(DateTimeOffset.UtcNow); await Repository.SaveAsync(campaign); await LoadAsync(); }
 private string RulesetName(Campaign campaign)
 {
  if (campaign.Ruleset is null) return "No ruleset";
  var name = rulesets.FirstOrDefault(item => item.Reference == campaign.Ruleset)?.Name;
  return name is null ? $"Unavailable - {campaign.Ruleset}" : $"{name} - {campaign.Ruleset}";
 }
 private sealed class Draft { public string Name { get; set; } = ""; public string Ruleset { get; set; } = ""; public string? Setting { get; set; } public string? Summary { get; set; } } private sealed class PackageDraft { public string RepositoryUrl { get; set; } = ""; public string Revision { get; set; } = "main"; public string Credential { get; set; } = ""; public string? Passphrase { get; set; } }
}
