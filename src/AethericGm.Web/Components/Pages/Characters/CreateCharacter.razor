@page "/campaigns/{CampaignId:guid}/characters/new"
@inject ICampaignRepository CampaignRepository
@inject ICharacterRepository CharacterRepository
@inject RulesetWorkspaceResolver Rulesets
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IDiceRoller DiceRoller
@using AethericGm.Web.Rules

<PageTitle>Create character · Aetheric GM</PageTitle>

@if (campaign is null)
{
 <header class="page-header"><div><p class="eyebrow">Character creation</p><h1>Campaign unavailable</h1><p>@(error ?? "The requested campaign could not be found.")</p></div></header>
}
else
{
 <header class="page-header"><div><p class="eyebrow">@campaign.Name · Character creation</p><h1>Create a character</h1><p>@(creation is null ? "This campaign is not ready to create characters." : $"Create a character governed by {creation.Ruleset.Name} {creation.Ruleset.Reference.Version}.")</p></div><a class="quiet action-link" href="/">Back to campaign</a></header>
 @if (!string.IsNullOrWhiteSpace(error)) { <p class="save-message error" role="alert">@error</p> }
 @if (creation is not null)
 {
  <section class="character-creation panel">
   <label>@creation.NameField.Label <input @bind="name" autofocus autocomplete="off" /></label>
   <fieldset class="ancestry-picker">
    <legend>@creation.AncestryField.Label</legend>
    @foreach (var ancestry in creation.Ancestries)
    {
     var token = $"{ancestry.RecordType}/{ancestry.Key}";
     <label class="ancestry-choice @(ancestryToken == token ? "selected" : "")">
      <input type="radio" name="ancestry" value="@token" @onchange="() => ancestryToken = token" checked="@(ancestryToken == token)" />
      <span><strong>@creation.Label(ancestry)</strong>@foreach (var detail in TextDetails(ancestry)) { <small>@detail</small> }</span>
     </label>
    }
   </fieldset>
   @if (creation.AttributeFields.Count > 0)
   {
    <section class="attribute-allocation" aria-labelledby="attribute-heading">
     <div class="attribute-heading"><div><h2 id="attribute-heading">Assign attribute scores</h2><p>Roll six scores with <code>4d6kh3</code>, then select a score and choose the attribute that receives it.</p></div><button type="button" class="quiet" @onclick="RollScores">@(rolledScores.Count == 0 ? "Roll scores" : "Reroll")</button></div>
     @if (rolledScores.Count > 0)
     {
      <div class="score-pool" aria-label="Available rolled scores">
       @foreach (var score in AvailableScores)
       { <button type="button" class="score-token @(selectedScoreId == score.Id ? "selected" : null)" aria-label="Select rolled score @score.Value" aria-pressed="@(selectedScoreId == score.Id)" @onclick="() => SelectScore(score.Id)">@score.Value</button> }
       @if (!AvailableScores.Any()) { <span class="all-assigned">All scores assigned.</span> }
      </div>
      <div class="attribute-grid">
       @foreach (var attributeField in creation.AttributeFields)
       {
        var score = AssignedScore(attributeField.Key);
        <button type="button" class="attribute-slot @(score is null ? null : "assigned")" aria-label="@(score is null ? $"Assign selected score to {attributeField.Label}" : $"Unassign {score.Value} from {attributeField.Label}")" @onclick="() => ToggleAssignment(attributeField.Key)">
         <span>@attributeField.Label</span><strong>@(score?.Value.ToString() ?? "—")</strong><small>@(score is null ? "Choose" : "Click to unassign")</small>
        </button>
       }
      </div>
      <button type="button" class="danger reset-allocation" @onclick="ResetAssignments" disabled="@(assignments.Count == 0)">Reset assignments</button>
     }
    </section>
   }
   <div class="actions"><button class="primary" disabled="@(!CanSave)" @onclick="SaveAsync">@(saving ? "Creating…" : "Create character")</button><a class="quiet action-link" href="/">Cancel</a></div>
  </section>
 }
}

@code {
 [Parameter] public Guid CampaignId { get; set; }
 private Campaign? campaign; private CharacterCreationDefinition? creation; private string name = ""; private string ancestryToken = ""; private string? error; private bool saving;
 private readonly List<RolledScore> rolledScores = []; private readonly Dictionary<string, Guid> assignments = new(StringComparer.Ordinal); private Guid? selectedScoreId;
 private IEnumerable<RolledScore> AvailableScores => rolledScores.Where(score => !assignments.ContainsValue(score.Id));
 private bool CanSave => !saving && (creation?.AttributeFields.Count is not > 0 || assignments.Count == creation.AttributeFields.Count);

 protected override async Task OnParametersSetAsync()
 {
  campaign = await CampaignRepository.GetAsync(CampaignId); creation = null; error = null;
  if (campaign is null) return;
  if (campaign.Ruleset is null) { error = "Select a ruleset for this campaign before creating a character."; return; }
  try
  {
   var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
   var owner = user.FindFirstValue("sub") ?? user.FindFirstValue(ClaimTypes.NameIdentifier);
   var workspace = await Rulesets.ResolveAsync(campaign.Ruleset, owner);
   if (workspace is null) { error = $"The pinned ruleset {campaign.Ruleset} is unavailable."; return; }
   if (workspace.CharacterSheet is null) { error = $"{workspace.Descriptor.Name} does not provide a character-sheet definition."; return; }
   creation = new CharacterCreationDefinition(workspace.Descriptor, workspace.CharacterSheet);
  }
  catch (Exception exception) when (exception is ArgumentException or InvalidDataException or System.Text.Json.JsonException) { error = exception.Message; }
 }

 private async Task SaveAsync()
 {
  if (campaign?.Ruleset is null || creation is null) return;
  saving = true; error = null;
  try
  {
   var parts = ancestryToken.Split('/', 2);
   if (parts.Length != 2) throw new ArgumentException("Choose an ancestry.");
   var scores = assignments.ToDictionary(pair => pair.Key, pair => rolledScores.Single(score => score.Id == pair.Value).Value, StringComparer.Ordinal);
   var values = creation.CreateValues(name, new RulesRecordReference(parts[0], parts[1]), scores);
   var character = Character.Create(campaign.Id, campaign.Ruleset, values, DateTimeOffset.UtcNow);
   await CharacterRepository.SaveAsync(character);
   Navigation.NavigateTo($"/campaigns/{campaign.Id}/characters/{character.Id}");
  }
  catch (Exception exception) when (exception is ArgumentException or InvalidDataException) { error = exception.Message; }
  finally { saving = false; }
 }

 private void RollScores()
 {
  rolledScores.Clear(); assignments.Clear(); selectedScoreId = null;
  for (var index = 0; index < 6; index++)
  {
   var result = DiceRoller.Roll(new DiceRollRequest(4, 6, label: $"Attribute score {index + 1}", keepHighest: 3));
   rolledScores.Add(new RolledScore(result.Id, result.Total));
  }
 }

 private void SelectScore(Guid id) => selectedScoreId = selectedScoreId == id ? null : id;
 private RolledScore? AssignedScore(string attributeKey) => assignments.TryGetValue(attributeKey, out var id) ? rolledScores.Single(score => score.Id == id) : null;
 private void ToggleAssignment(string attributeKey)
 {
  if (assignments.Remove(attributeKey)) return;
  if (selectedScoreId is not { } id || assignments.ContainsValue(id)) return;
  assignments[attributeKey] = id; selectedScoreId = null;
 }
 private void ResetAssignments() { assignments.Clear(); selectedScoreId = null; }

 private IEnumerable<string> TextDetails(RulesRecord record)
 {
  var displayField = creation?.Ruleset.RecordTypes.Find(record.RecordType)?.DisplayField;
  return record.Values.Where(pair => pair.Key != displayField && pair.Value.ValueKind == System.Text.Json.JsonValueKind.String)
   .Select(pair => pair.Value.GetString()).Where(value => !string.IsNullOrWhiteSpace(value))!;
 }

 private sealed record RolledScore(Guid Id, int Value);
}
